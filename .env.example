# 宿主机访问端口与绑定地址。默认只在本机开放；由 Caddy 通过容器网络访问后端。
PORT=8000
APP_BIND_HOST=127.0.0.1

# 生产 HTTPS：填写真实域名，然后使用 compose.https.yaml。
COLLAB_DOMAIN=collab.example.com
COLLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTP 本地开发用 auto；生产 HTTPS 必须设为 true。
COLLAB_COOKIE_SECURE=auto
# 只有请求经过可信反向代理时设为 true，才会读取 X-Forwarded-For。
COLLAB_TRUST_PROXY=false

# 可选 PostgreSQL 生产部署（使用 compose.postgres.yaml 时必须设置密码）。
POSTGRES_DB=collab_ledger
POSTGRES_USER=collab
POSTGRES_PASSWORD=请设置高强度密码
# 非容器部署也可直接配置完整连接串，设置后优先于 COLLAB_DB。
# DATABASE_URL=postgresql+psycopg://collab:password@127.0.0.1:5432/collab_ledger

# OpenAI Chat Completions 兼容协议（不是 Responses API）。
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=请填入你的APIKey
LLM_MODEL=step-3.7-flash
# 留空时由 LLM_BASE_URL 自动拼接 /v1/chat/completions。
LLM_CHAT_COMPLETIONS_URL=

# LLM 超时与采样，推荐系统与 Agent 共用。
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
# 推理模型强度:low/medium/high,留空则不传;Agent 决策识别到 content 为空会自动用 low 重试
LLM_REASONING_EFFORT=
# 语义技能匹配可选 Embedding；留空时按 LLM_BASE_URL 拼接 /v1/embeddings。
LLM_EMBEDDING_URL=
LLM_EMBEDDING_MODEL=text-embedding-3-small

# D1 推荐：llm=默认语义匹配，embedding=向量相似度，rule=纯规则。无 Key 时自动回退规则。
RECOMMEND_SKILL_MODE=llm
RECOMMEND_USE_LLM_SKILL=true
RECOMMEND_USE_LLM_REASON=true
RECOMMEND_SKILL_AI_WEIGHT=0.55
RECOMMEND_LLM_TIMEOUT=30  # 弱网可调大；达到超时会自动重试一次再降级规则

# D5 GitHub 接入。repo scope 同时支持同步与用户显式确认后的 Issue/PR 反向写入。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/github/callback
# 平台令牌 Fernet 加密根密钥；生产环境必填高熵随机值，禁止使用仓库默认值。
GITHUB_TOKEN_SECRET=
# 可选 Webhook：公网 HTTPS 基址与 GitHub Webhook 签名密钥。
GITHUB_WEBHOOK_BASE_URL=
GITHUB_WEBHOOK_SECRET=

# D5 飞书用户 OAuth 与云文档/知识库读取。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 前端从贡献页发起 OAuth 时会提交当前页面地址；也可固定配置回调地址。
FEISHU_REDIRECT_URI=

# D5 腾讯文档官方 Open API。根地址固定为 https://docs.qq.com。
TENCENT_DOC_APP_ID=
TENCENT_DOC_API_BASE=https://docs.qq.com
